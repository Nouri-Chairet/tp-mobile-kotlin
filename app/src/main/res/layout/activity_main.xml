<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F7"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espace_page">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#203148"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titre_atelier"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sous_titre_formulaire"
                android:textColor="#C7D5DE"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_nom" />

        <EditText
            android:id="@+id/etNom"
            style="@style/FormField"
            android:hint="@string/hint_nom"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_prenom" />

        <EditText
            android:id="@+id/etPrenom"
            style="@style/FormField"
            android:hint="@string/hint_prenom"
            android:inputType="textPersonName|textCapWords" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_age" />

        <EditText
            android:id="@+id/etAge"
            style="@style/FormField"
            android:hint="@string/hint_age"
            android:inputType="number" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_groupe" />

        <Spinner
            android:id="@+id/spGroupe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/groupes"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_support" />

        <RadioGroup
            android:id="@+id/rgSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEmulateur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/radio_emulateur" />

            <RadioButton
                android:id="@+id/rbTelephone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/radio_telephone" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbConfirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkbox_confirmation" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAfficher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_afficher" />

            <Button
                android:id="@+id/btnEffacer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_effacer" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEnregistrer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#267B73"
            android:text="@string/btn_enregistrer"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#E8F3F0"
            android:padding="12dp"
            android:text="@string/resultat_defaut"
            android:textColor="#40566A"
            android:textSize="14sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_inscriptions" />

        <TextView
            android:id="@+id/tvCompteur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#DCEBE7"
            android:padding="12dp"
            android:text="@string/compteur_initial"
            android:textColor="#203148"
            android:textStyle="bold" />

        <TextView
            style="@style/FormLabel"
            android:text="@string/label_filtre" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spFiltreGroupe"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:entries="@array/filtres_groupes" />

            <Button
                android:id="@+id/btnFiltrer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_filtrer" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#267B73"
            android:text="@string/menu_ouvrir"
            android:textColor="#FFFFFF" />

        <ListView
            android:id="@+id/lvParticipants"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="#FFFFFF"
            android:divider="#DCE3E7"
            android:dividerHeight="1dp"
            android:nestedScrollingEnabled="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnModifier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/btn_modifier" />

            <Button
                android:id="@+id/btnSupprimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/btn_supprimer" />

            <Button
                android:id="@+id/btnAnnuler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/btn_annuler" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
